# URL du projet Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clé service role — UNIQUEMENT côté serveur, ne jamais exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Jeton admin unique (import Excel + connexion /admin/login).
# Stocké côté serveur ; après login, cookie httpOnly `admin_session` (7 jours).
# Choisir une valeur longue et secrète (8 caractères minimum).
IMPORT_ADMIN_TOKEN=your-import-admin-token

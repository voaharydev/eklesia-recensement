# URL du projet Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clé service role — UNIQUEMENT côté serveur, ne jamais exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Jeton pour la page d’import admin (/admin/import) — choisir une valeur longue et secrète
IMPORT_ADMIN_TOKEN=your-import-admin-token
